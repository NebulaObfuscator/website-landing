---
import FeatureCard from "./cards/FeatureCard.astro";
import CrosshairIcon from "@icons/CrosshairIcon.astro";
import HierarchyIcon from "@icons/HierarchyIcon.astro";
import LockIcon from "@icons/LockIcon.astro";
import PluginsIcon from "@icons/PluginsIcon.astro";
import RemoveIcon from "@icons/RemoveIcon.astro";
import SwitchIcon from "@icons/SwitchIcon.astro";

const featureGroups = [
  {
    category: "Core Features",
    features: [
      {
        Icon: HierarchyIcon,
        title: "Name Obfuscation",
        text: "Rename classes, fields, and methods without destroying the hierarchy.",
      },
      {
        Icon: PluginsIcon,
        title: "Paper, Bungee & Velocity Support",
        text: "Natively supports Minecraft plugins & mods without breaking anything.",
      },
      {
        Icon: LockIcon,
        title: "Documentation",
        text: "Comes with documentation on how to write a proper authentication system.",
      },
    ],
  },
  {
    category: "Code Structure Changes",
    features: [
      {
        Icon: RemoveIcon,
        title: "Method Inlining",
        text: "Inline eligible method calls to obscure control flow and reduce call-graph clarity.",
      },
      {
        Icon: HierarchyIcon,
        title: "Local Variable Table Obfuscation",
        text: "Pack every two local 32-bit integers into one 64-bit local long.",
      },
      {
        Icon: CrosshairIcon,
        title: "Line Number Obfuscation",
        text: "Scramble line number metadata to make stack traces harder to map back to source.",
      },
      {
        Icon: PluginsIcon,
        title: "Useless Reference Injection",
        text: "Dead code insertion like never seen before.",
      },
    ],
  },
  {
    category: "Data Obfuscation",
    features: [
      {
        Icon: LockIcon,
        title: "String Encryption",
        text: "Use AES-CBC, SHA256 & MD5 and lookup tables to hide string literals.",
      },
      {
        Icon: LockIcon,
        title: "Number Encryption",
        text: "Encrypt numbers with class salts.",
      },
      {
        Icon: LockIcon,
        title: "Constant Export & Encryption",
        text: "Export all string constants into one resource file.",
      },
      {
        Icon: LockIcon,
        title: "Resource Encryption",
        text: "Encrypt, bundle & compress resources.",
      },
      {
        Icon: RemoveIcon,
        title: "Annotation Encryption",
        text: "Encrypt strings & numbers inside annotations.",
      },
      {
        Icon: CrosshairIcon,
        title: "Method Salting",
        text: "Pass keys through method parameters.",
      },
    ],
  },
  {
    category: "References & Flow Obfuscation",
    features: [
      {
        Icon: SwitchIcon,
        title: "Switch to Ifs",
        text: "Convert switch table to ifs to make reverse engineering harder.",
      },
      {
        Icon: HierarchyIcon,
        title: "Reference Obfuscation",
        text: "Hide method & field references.",
      },
      {
        Icon: CrosshairIcon,
        title: "Control Flow Flattening",
        text: "Flatten control flow & shuffle blocks.",
      },
      {
        Icon: CrosshairIcon,
        title: "Exception Flow Obfuscation",
        text: "Add dead exception handlers to mess with decompilers.",
      },
    ],
  },
  {
    category: "Maximum Security",
    features: [
      {
        Icon: LockIcon,
        title: "Virtual Machine Protection",
        text: "Interpret code through a proprietary VM layer.",
      },
    ],
  },
];
---

<section class="features website-section" id="features">
  <div class="section-header">
    <h2 class="title animate-fade-slide-down">Main Features</h2>
    <p class="subtitle animate-fade-slide-up">
      A complete obfuscation pipeline that turns reverse engineering your Java
      code into a nightmare.
    </p>
  </div>

  <div class="feature-groups animate-fade-slide-up">
    {
      featureGroups.map((group) => (
        <div class="feature-group">
          <div class="group-title">
            <span class="group-line"></span>
            <h3>{group.category}</h3>
            <span class="group-line"></span>
          </div>
          <div class="features-grid">
            {
              group.features.map(({ Icon, title, text }) => (
                <FeatureCard Icon={Icon} title={title} text={text} />
              ))
            }
          </div>
        </div>
      ))
    }
  </div>
</section>

<style>
  .features {
    padding-top: calc(var(--nav-height) + var(--padding-top-nav-section));
  }

  .section-header {
    max-width: 700px;
    padding: 0 1rem;
  }

  .title {
    font-size: clamp(1.75rem, 5vw, 2.75rem);
    font-weight: 800;
    letter-spacing: -1px;
    color: var(--text-primary);
    margin-bottom: 12px;
  }

  .subtitle {
    font-size: 1rem;
    line-height: 1.7;
    color: var(--text-secondary);
  }

  .feature-groups {
    display: flex;
    flex-direction: column;
    gap: 2.75rem;
    width: 100%;
    max-width: 1200px;
    padding: 0 1rem;
  }

  .feature-group {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .group-title {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
  }

  .group-title h3 {
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--accent-bright);
    white-space: nowrap;
  }

  .group-line {
    height: 1px;
    flex: 1;
    max-width: 160px;
    background: linear-gradient(
      90deg,
      transparent,
      var(--border-soft),
      transparent
    );
  }

  .features-grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 14px;
    width: 100%;
  }

  @media (min-width: 640px) {
    .features-grid {
      gap: 16px;
    }
  }

  @media (min-width: 1024px) {
    .features-grid {
      gap: 18px;
    }
  }
</style>
