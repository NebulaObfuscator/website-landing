---
import { discordUrl } from "@constants/urls";
import PricingCard from "./cards/PricingCard.astro";

const pricingPlans = [
  {
    tier: "Standard",
    price: "$35",
    period: "6 months",
    popular: false,
    summary: "Full protection for short-term or single-release projects.",
    features: [
      "Class, field & method name renaming",
      "Annotation & resource encryption",
      "Constant exporting to file",
      "Control flow flattening",
      "Line number mangling",
      "Method inlining",
      "Number & string encryption",
      "Reference obfuscation",
      "Switch to if conversion",
      "Junk code insertion",
      "Code virtualization",
      "Miscellaneous obfuscations",
    ],
    note: "One-time payment. Free updates for 6 months.",
    buttonText: "Get 6 Months",
    buttonUrl: discordUrl,
  },
  {
    tier: "Annual",
    price: "$60",
    period: "12 months",
    popular: true,
    summary: "Best value for long-running, continuously updated projects.",
    features: [
      "Class, field & method name renaming",
      "Annotation & resource encryption",
      "Constant exporting to file",
      "Control flow flattening",
      "Line number mangling",
      "Method inlining",
      "Number & string encryption",
      "Reference obfuscation",
      "Switch to if conversion",
      "Junk code insertion",
      "Code virtualization",
      "Miscellaneous obfuscations",
    ],
    note: "One-time payment. Free updates for 12 months.",
    buttonText: "Get 12 Months",
    buttonUrl: discordUrl,
  },
];
---

<section class="pricing-section website-section" id="pricing">
  <div class="section-header">
    <h2 class="title animate-fade-slide-down">Pricing Plans</h2>
    <p class="subtitle animate-fade-slide-up">
      One-time payment. Every plan includes the complete Nebula protection
      pipeline.
    </p>
  </div>

  <div class="pricing-grid">
    {
      pricingPlans.map((plan) => (
        <PricingCard {...plan} />
      ))
    }
  </div>
</section>

<style>
  .pricing-section {
    padding-top: calc(var(--nav-height) + var(--padding-top-nav-section));
  }

  .section-header {
    max-width: 700px;
    padding: 0 1rem;
    margin-bottom: 0.5rem;
  }

  .title {
    font-size: clamp(1.75rem, 5vw, 2.75rem);
    font-weight: 800;
    letter-spacing: -1px;
    color: var(--text-primary);
    margin-bottom: 12px;
  }

  .subtitle {
    font-size: 1rem;
    line-height: 1.7;
    color: var(--text-secondary);
  }

  .pricing-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    max-width: 1000px;
    width: 100%;
    margin: 0 auto;
    padding: 0 1rem;
    align-items: stretch;
  }

  @media (min-width: 769px) {
    .pricing-grid {
      grid-template-columns: repeat(2, 1fr);
      align-items: center;
    }
  }
</style>
