---
import Prism from "prismjs";

const { title, code } = Astro.props;
const highlightedCode = Prism.highlight(code, Prism.languages.java, "java");
---

<article class="card animate-fade-slide-up">
  <div class="card-head">
    <span class="dot"></span>
    <h3 class="card-title">{title}</h3>
  </div>
  <pre
    class="code-block"><code class="language-java" set:html={highlightedCode} /></pre>
</article>

<style>
  .card {
    width: 100%;
    max-width: 760px;
    display: flex;
    flex-direction: column;
    padding: 1.5rem;
    border-radius: var(--radius-xl);
    background: linear-gradient(180deg, var(--bg-elevated), rgba(16, 16, 24, 0.94));
    border: 1px solid var(--border-subtle);
    box-shadow: var(--shadow-card);
    backdrop-filter: blur(10px);
    box-sizing: border-box;
  }

  .card-head {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 1rem;
    padding: 0 4px;
  }

  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent-bright);
    box-shadow: 0 0 0 4px rgba(99, 102, 241, 0.16);
  }

  .card-title {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--text-primary);
    letter-spacing: 0.2px;
  }

  .code-block {
    background: #0a0b12 !important;
    padding: 1.25rem;
    border-radius: var(--radius-md);
    border: 1px solid var(--border-subtle);
    overflow-x: auto;
    flex: 1;
    text-align: start;
    min-height: 320px;
    max-height: 65vh;
    font-family: "SF Mono", Menlo, Consolas, monospace;
    font-size: clamp(0.8rem, 1.6vw, 1rem);
    line-height: 1.7;
    box-sizing: border-box;
    scrollbar-width: thin;
    scrollbar-color: rgba(99, 102, 241, 0.5) rgba(255, 255, 255, 0.04);
  }

  .code-block::-webkit-scrollbar {
    width: 10px;
    height: 10px;
  }

  .code-block::-webkit-scrollbar-track {
    background: rgba(255, 255, 255, 0.04);
  }

  .code-block::-webkit-scrollbar-thumb {
    background: rgba(99, 102, 241, 0.5);
    border-radius: 5px;
    border: 2px solid #0a0b12;
  }

  .code-block::-webkit-scrollbar-thumb:hover {
    background: rgba(99, 102, 241, 0.7);
  }

  .code-block::-webkit-scrollbar-corner {
    background: rgba(255, 255, 255, 0.04);
  }

  @media (min-width: 1024px) {
    .code-block {
      max-height: 520px;
    }
  }
</style>
