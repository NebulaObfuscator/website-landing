---
import { dashboardUrl, discordUrl } from "@constants/urls";
import logo from "@public/logo.webp";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta
      name="description"
      content="Nebula — advanced Java bytecode obfuscation for Minecraft plugins and applications."
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Sora:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <title>Nebula | Java Obfuscator</title>
  </head>
  <body>
    <div class="stars" id="stars"></div>
    <nav>
      <div class="nav-title">
        <img src={logo.src} alt="Nebula official logo" class="nav-logo" />
        <h3>Nebula</h3>
      </div>
      <div
        class="nav-toggle"
        id="nav-toggle"
        aria-label="Toggle navigation menu"
        role="button"
        tabindex="0"
      >
        <span></span>
        <span></span>
        <span></span>
      </div>
      <ul class="nav-urls" id="nav-urls">
        <li class="nav-item"><a href="#features">Features</a></li>
        <li class="nav-item"><a href="#demo">Demo</a></li>
        <li class="nav-item"><a href="#pricing">Pricing</a></li>
        <li class="nav-item">
          <a
            href={String(dashboardUrl)}
            target="_blank"
            rel="noopener noreferrer"
            >Dashboard</a
          >
        </li>
        <li class="nav-item">
          <a
            class="nav-discord"
            href={String(discordUrl)}
            target="_blank"
            rel="noopener noreferrer"
            >Discord</a
          >
        </li>
      </ul>
    </nav>
    <slot />
    <footer class="animate-fade-slide-up">
      <span
        >© 2025-2026 Nebula Obfuscator. Protecting your Java code with
        state-of-the-art technology.
      </span>
    </footer>
  </body>
</html>

<style>
  nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: var(--nav-height);
    padding: 0 48px;
    background: rgba(8, 9, 15, 0.84);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom: 1px solid var(--border-subtle);
    z-index: 100;
    box-shadow: 0 10px 35px rgba(0, 0, 0, 0.16);
  }

  .nav-title {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--text-primary);
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: -0.3px;
  }

  .nav-logo {
    height: 1.4em;
    width: 1.4em;
    border-radius: 6px;
  }

  .nav-toggle {
    display: none;
    flex-direction: column;
    justify-content: space-around;
    width: 24px;
    height: 24px;
    gap: 4px;
    cursor: pointer;
  }

  .nav-toggle span {
    display: block;
    width: 100%;
    height: 2.5px;
    background: var(--text-secondary);
    border-radius: 2px;
    transition: all 0.3s ease;
  }

  .nav-toggle span.open {
    margin-left: 20px;
  }

  .nav-urls {
    position: fixed;
    top: 0;
    right: 0;
    width: 220px;
    height: 100vh;
    padding: 110px 24px 24px;
    background: var(--bg-surface);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
    border-left: 1px solid var(--border-subtle);
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 6px;
    font-size: 1rem;
    pointer-events: none;
    visibility: hidden;
    transform: translateX(calc(100% + 20px));
    transition:
      transform 0.28s ease,
      visibility 0.28s ease;
    box-shadow: var(--shadow-raised);
  }

  .nav-urls.open {
    visibility: visible;
    pointer-events: auto;
    transform: translateX(0);
  }

  .nav-item a {
    display: block;
    padding: 11px 14px;
    border-radius: var(--radius-md);
    color: var(--text-secondary);
    font-weight: 500;
    transition:
      color 0.15s ease,
      background 0.15s ease;
  }

  .nav-item a:hover {
    color: var(--text-primary);
    background: var(--bg-hover);
  }

  .nav-discord {
    margin-top: 8px;
    text-align: center;
    color: #fff;
    background: linear-gradient(135deg, var(--accent), #4f46e5);
    box-shadow: 0 8px 20px rgba(99, 102, 241, 0.24);
  }

  .nav-discord:hover {
    background: linear-gradient(135deg, var(--accent-bright), var(--accent));
  }

  footer {
    width: 100%;
    display: flex;
    justify-content: center;
    text-align: center;
    align-items: center;
    padding: 36px 20px;
    margin-top: 4rem;
    border-top: 1px solid var(--border-subtle);
    background: rgba(8, 9, 15, 0.6);
    color: var(--text-muted);
    position: relative;
    z-index: 1;
  }

  footer span {
    font-size: 0.9rem;
    max-width: 640px;
    line-height: 1.6;
    padding: 0 20px;
  }

  @media (min-width: 769px) {
    .nav-toggle {
      display: none;
    }

    .nav-urls {
      position: static;
      width: auto;
      height: auto;
      background: transparent;
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
      border-left: none;
      border-radius: 0;
      flex-direction: row;
      align-items: center;
      padding: 0;
      gap: 6px;
      font-size: 0.95rem;
      pointer-events: auto;
      visibility: visible;
      transform: none;
      transition: none;
      box-shadow: none;
    }

    .nav-discord {
      margin-top: 0;
      margin-left: 8px;
      padding: 10px 18px;
    }
  }
</style>

<style is:global>
  :root {
    /* Midnight theme */
    --bg-base: #06070d;
    --bg-surface: rgba(17, 18, 28, 0.92);
    --bg-elevated: rgba(24, 24, 36, 0.95);
    --bg-overlay: rgba(34, 36, 52, 0.95);
    --bg-hover: rgba(255, 255, 255, 0.055);

    --border-subtle: rgba(255, 255, 255, 0.06);
    --border-soft: rgba(255, 255, 255, 0.1);
    --border-mid: rgba(255, 255, 255, 0.16);

    --accent: #6366f1;
    --accent-bright: #818cf8;
    --accent-dim: rgba(99, 102, 241, 0.18);
    --accent-glow: rgba(99, 102, 241, 0.34);

    --cyan: #22d3ee;
    --cyan-dim: rgba(34, 211, 238, 0.14);

    --green: #34d399;
    --green-dim: rgba(52, 211, 153, 0.15);

    --red: #f87171;
    --red-dim: rgba(248, 113, 113, 0.14);

    --pink: #f472b6;
    --pink-dim: rgba(244, 114, 182, 0.15);

    --text-primary: #f1f0f5;
    --text-secondary: #a8a5b8;
    --text-muted: #6d6b7d;

    --radius-sm: 8px;
    --radius-md: 12px;
    --radius-lg: 16px;
    --radius-xl: 20px;

    --shadow-card: 0 10px 30px rgba(0, 0, 0, 0.28),
      inset 0 1px 0 rgba(255, 255, 255, 0.04);
    --shadow-raised: 0 20px 45px rgba(0, 0, 0, 0.38);

    --font-body: "Sora", "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;

    /* Layout */
    --nav-height: 84px;
    --padding-top-nav-section: 48px;
  }

  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    list-style: none;
    text-decoration: none;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    min-height: 100vh;
    font-family: var(--font-body);
    background:
      radial-gradient(circle at top left, rgba(99, 102, 241, 0.16), transparent 35%),
      radial-gradient(circle at bottom right, rgba(34, 211, 238, 0.12), transparent 30%),
      var(--bg-base);
    color: var(--text-primary);
    overflow-x: hidden;
    position: relative;
  }

  body::before {
    content: "";
    position: fixed;
    inset: 0;
    z-index: 0;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.018) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.018) 1px, transparent 1px);
    background-size: 32px 32px;
    mask-image: linear-gradient(180deg, rgba(0, 0, 0, 0.7), transparent 90%);
    -webkit-mask-image: linear-gradient(180deg, rgba(0, 0, 0, 0.7), transparent 90%);
    pointer-events: none;
  }

  body::after {
    content: "";
    position: fixed;
    inset: 0;
    z-index: 0;
    background: radial-gradient(
      ellipse at 20% 10%,
      rgba(99, 102, 241, 0.08),
      transparent 40%
    );
    pointer-events: none;
  }

  .website-section {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    min-height: 100vh;
    padding: 4rem 1rem 2rem;
    gap: 2.5rem;
    overflow: hidden;
    position: relative;
    z-index: 1;
    scroll-margin-top: calc(var(--nav-height) + 12px);
  }

  .stars {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    overflow: hidden;
  }

  .star {
    position: absolute;
    width: 2px;
    height: 2px;
    background: rgba(255, 255, 255, 0.6);
    border-radius: 50%;
    animation: twinkle 3.5s ease-in-out infinite;
  }

  @keyframes twinkle {
    0%,
    100% {
      opacity: 0.15;
    }
    50% {
      opacity: 0.7;
    }
  }

  /* Scroll animations */
  .animate-fade-slide-down,
  .text-glow-pulse,
  .animate-fade-slide-up {
    opacity: 0;
    transform: translateY(20px);
    filter: blur(6px);
  }

  .animate-fade-slide-down.active {
    animation: fadeInSlideDown 1.2s ease forwards;
  }

  .animate-fade-slide-up.active {
    animation: fadeInSlideUp 1.2s ease forwards 0.25s;
  }

  .text-glow-pulse.active {
    animation: textGlowPulse 3s infinite ease-in-out;
  }

  @keyframes fadeInSlideDown {
    from {
      opacity: 0;
      transform: translateY(-25px) scale(0.96);
      filter: blur(6px);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
      filter: blur(0);
    }
  }

  @keyframes fadeInSlideUp {
    from {
      opacity: 0;
      transform: translateY(20px);
      filter: blur(6px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
      filter: blur(0);
    }
  }

  @keyframes textGlowPulse {
    0% {
      opacity: 0.85;
      text-shadow: 0 0 8px rgba(129, 140, 248, 0.35);
    }
    50% {
      opacity: 1;
      text-shadow: 0 0 16px rgba(34, 211, 238, 0.6);
    }
    100% {
      opacity: 0.85;
      text-shadow: 0 0 8px rgba(129, 140, 248, 0.35);
    }
  }

  *::-webkit-scrollbar {
    width: 10px;
    height: 10px;
  }

  *::-webkit-scrollbar-track {
    background: transparent;
  }

  *::-webkit-scrollbar-thumb {
    background: rgba(99, 102, 241, 0.35);
    border-radius: 5px;
    border: 2px solid var(--bg-base);
  }

  *::-webkit-scrollbar-thumb:hover {
    background: rgba(99, 102, 241, 0.55);
  }

  *::-webkit-scrollbar-corner {
    background: transparent;
  }

  html {
    scrollbar-width: thin;
    scrollbar-color: rgba(99, 102, 241, 0.45) transparent;
  }
</style>

<script>
  import { initAnimateOnScroll } from "@scripts/ui/animateOnScroll";
  initAnimateOnScroll();

  import { generateStars } from "@scripts/ui/stars";
  generateStars();

  const navToggle: HTMLElement | null = document.getElementById("nav-toggle");
  const navUrls: HTMLElement | null = document.getElementById("nav-urls");
  const hamburgerSpans: NodeListOf<HTMLSpanElement> | undefined =
    navToggle?.querySelectorAll("span");

  navToggle?.addEventListener("click", () => {
    navUrls?.classList.toggle("open");

    if (hamburgerSpans) {
      hamburgerSpans.forEach((span, _) => {
        span.classList.toggle("open");
      });
    }
  });
</script>
